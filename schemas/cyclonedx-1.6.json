{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://cyclonedx.org/schema/bom-1.6.schema.json",
  "type": "object",
  "title": "CycloneDX 1.6 Cryptographic Bill of Materials (ECMA-424)",
  "required": ["bomFormat", "specVersion", "version"],
  "properties": {
    "bomFormat": {
      "type": "string",
      "enum": ["CycloneDX"]
    },
    "specVersion": {
      "type": "string",
      "enum": ["1.4", "1.5", "1.6"]
    },
    "serialNumber": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "string" },
        "tools": { "type": "object" },
        "authors": { "type": "array" },
        "component": { "type": "object" }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cryptographic-asset",
              "library",
              "framework",
              "application",
              "container",
              "operating-system",
              "device",
              "file",
              "service"
            ]
          },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "bom-ref": { "type": "string" },
          "description": { "type": "string" },
          "scope": { "type": "string" },
          "cryptoProperties": {
            "type": "object",
            "required": ["assetType"],
            "properties": {
              "assetType": {
                "type": "string",
                "enum": [
                  "algorithm",
                  "certificate",
                  "protocol",
                  "related-crypto-material"
                ]
              },
              "algorithmProperties": {
                "type": "object",
                "properties": {
                  "primitive": {
                    "type": "string",
                    "enum": [
                      "cipher",
                      "digest",
                      "signature",
                      "key-agree",
                      "pke",
                      "kem",
                      "mac",
                      "kdf",
                      "rng",
                      "other"
                    ]
                  },
                  "parameterSetIdentifier": { "type": ["string", "integer"] },
                  "curve": { "type": "string" },
                  "executionEnvironment": { "type": "string" },
                  "implementationPlatform": { "type": "string" },
                  "certificationLevel": { "type": "array", "items": { "type": "string" } },
                  "mode": { "type": "string" },
                  "padding": { "type": "string" },
                  "cryptoFunctions": { "type": "array", "items": { "type": "string" } },
                  "classicalSecurityLevel": { "type": "integer" },
                  "nistQuantumSecurityLevel": { "type": "integer" },
                  "oid": { "type": "string" }
                }
              },
              "certificateProperties": {
                "type": "object",
                "properties": {
                  "subjectName": { "type": "string" },
                  "issuerName": { "type": "string" },
                  "notValidBefore": { "type": "string" },
                  "notValidAfter": { "type": "string" },
                  "signatureAlgorithmRef": { "type": "string" },
                  "subjectPublicKeyRef": { "type": "string" },
                  "certificateFormat": { "type": "string" }
                }
              },
              "protocolProperties": {
                "type": "object",
                "properties": {
                  "type": { "type": "string" },
                  "version": { "type": "string" },
                  "cipherSuites": { "type": "array" },
                  "ikeVersion": { "type": "string" }
                }
              },
              "relatedCryptoMaterialProperties": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["private-key", "public-key", "secret-key", "other"]
                  },
                  "size": { "type": "integer" },
                  "format": { "type": "string" },
                  "creationDate": { "type": "string" },
                  "activationDate": { "type": "string" }
                }
              },
              "oid": { "type": "string" }
            }
          },
          "properties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}

